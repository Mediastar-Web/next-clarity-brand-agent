# Every variable here is optional.
#
# `createBrandAgent()` with no arguments runs: the state lands in
# .data/brand-agent.json, the at-rest key is minted beside it, and the panel
# asks you to confirm the domain the first time you open it. What follows is
# what a real deployment pins on purpose — mostly facts the process cannot
# discover about itself.

# Public origin. Must be the real, internet-reachable domain: the Clarity
# dashboard calls it back mid-handshake to prove you own it. Leave it unset to
# confirm it from the panel instead.
BRAND_AGENT_SITE_URL=https://example.com

# Clarity project id (clarity.microsoft.com). Can also be linked from the panel.
CLARITY_PROJECT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Where the connection state lives. THE one thing worth setting: a persistent
# volume, not the container filesystem. Nothing can detect this from inside the
# process — lose the file and you lose the HMAC secret, and must reconnect.
BRAND_AGENT_STATE_PATH=/data/brand-agent.json

# Encrypts the HMAC secret at rest. openssl rand -base64 32
# Unset, one is generated into <state>.key (mode 0600) on first use.
BRAND_AGENT_SECRET_KEY=

# Control panel gate — OPTIONAL. Leave both unset and the panel asks you to
# choose a password the first time you open it, gated by the setup token the
# server prints to its log. Set them to pin the password from the environment
# instead (first-run setup is then refused).
BRAND_AGENT_ADMIN_PASSWORD=
BRAND_AGENT_SESSION_SECRET=
